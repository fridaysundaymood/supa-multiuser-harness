{
  "name": "@budaknyenyel/supa-multiuser-harness",
  "version": "0.1.0",
  "type": "module",
  "description": "Local Supabase multiuser security testing harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fridaysundaymood/supa-multiuser-harness.git"
  },
  "homepage": "https://github.com/fridaysundaymood/supa-multiuser-harness#readme",
  "bugs": {
    "url": "https://github.com/fridaysundaymood/supa-multiuser-harness/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": "./dist/core/index.js",
  "bin": {
    "backend": "./dist/cli/index.js",
    "backend-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
