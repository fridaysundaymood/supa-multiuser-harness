    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@budaknyenyel/kit-schema": "file:../android-kit/packages/kit-schema",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.0.0",
    "supabase": "2.75.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "supabase@2.75.0": true,
    "esbuild@0.28.2": true
  }
